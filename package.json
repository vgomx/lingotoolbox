{
  "name": "lingotoolbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "sync:assets": "cp node_modules/lingo-ds/assets/logo/mark-violet.svg public/",
    "predev": "npm run sync:assets",
    "prebuild": "npm run sync:assets",
    "dev": "vite",
    "build": "tsc -b && npm run check:illustrations && npm run check:etymology && vite build && cp dist/index.html dist/404.html",
    "check:illustrations": "node scripts/check-illustrations.mjs",
    "check:etymology": "node scripts/check-etymology.mjs",
    "build:illustrations": "node scripts/build-openmoji.mjs",
    "build:language-info": "node scripts/build-language-info.mjs",
    "build:language-links": "node scripts/resolve-language-links.mjs",
    "build:glosses": "node scripts/build-glosses.mjs",
    "build:etymology": "node scripts/build-etymology.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:icons": "node scripts/build-icons.mjs",
    "build:social-card": "node scripts/build-social-card.mjs"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "lingo-ds": "file:../lingo-ds",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
